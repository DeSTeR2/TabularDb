@using TabularDb.Core.Types

<section class="panel editor" aria-labelledby="row-editor-title">
    <h2 id="row-editor-title">@(Row is null ? "Новий рядок" : $"Рядок {Row.Id}")</h2>
    <form @onsubmit="SubmitAsync" @onkeydown="OnKeyDown">
        <div class="editor-fields">
            @for (var i = 0; i < Schema.Fields.Count; i++)
            {
                var index = i;
                var field = Schema.Fields[index];
                var error = _errors[index];
                <div class="field">
                    <label for="field-@index">@field.Name <span class="muted">@field.Type</span></label>
                    @if (index == 0)
                    {
                        <input id="field-@index" @ref="_first" @bind="_values[index]" autocomplete="off"
                               aria-invalid="@(error is not null ? "true" : null)" aria-describedby="hint-@index" />
                    }
                    else
                    {
                        <input id="field-@index" @bind="_values[index]" autocomplete="off"
                               aria-invalid="@(error is not null ? "true" : null)" aria-describedby="hint-@index" />
                    }
                    @if (error is not null)
                    {
                        <span id="hint-@index" class="field-error">@error</span>
                    }
                    else
                    {
                        <span id="hint-@index" class="field-help">@Hint(field.Type)</span>
                    }
                </div>
            }
        </div>
        @if (_otherErrors.Count > 0)
        {
            <div class="note note-error" role="alert">
                <ul style="margin: 0">
                    @foreach (var error in _otherErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
        <div class="editor-actions">
            <button type="submit" class="primary" disabled="@_busy">@(Row is null ? "Додати рядок" : "Зберегти зміни")</button>
            <button type="button" class="quiet" disabled="@_busy" @onclick="OnCancel">Скасувати</button>
            <p class="muted">Порожнє поле означає відсутнє значення. Esc — закрити.</p>
        </div>
    </form>
</section>

@code {
    private string[] _values = [];
    private string?[] _errors = [];
    private List<string> _otherErrors = [];
    private bool _busy;
    private ElementReference _first;

    [Parameter, EditorRequired] public TableSchemaDto Schema { get; set; } = null!;
    [Parameter] public RowDto? Row { get; set; }
    [Parameter, EditorRequired] public Func<IReadOnlyList<string?>, Task<ApiException?>> Submit { get; set; } = null!;
    [Parameter] public EventCallback OnCancel { get; set; }

    protected override void OnInitialized()
    {
        _values = Schema.Fields.Select((_, i) => Row?.Values.ElementAtOrDefault(i) ?? "").ToArray();
        _errors = new string?[Schema.Fields.Count];
        _otherErrors = [];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Schema.Fields.Count > 0)
            await _first.FocusAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !_busy)
            await OnCancel.InvokeAsync();
    }

    private static string Hint(string? type) =>
        TypeRegistry.TryGet(type, out var dataType) ? dataType.FormatHint : "";

    private async Task SubmitAsync()
    {
        var values = _values.Select(v => string.IsNullOrWhiteSpace(v) ? null : v).ToList();
        _otherErrors = [];
        var valid = true;
        for (var i = 0; i < Schema.Fields.Count; i++)
        {
            _errors[i] = null;
            if (TypeRegistry.TryGet(Schema.Fields[i].Type, out var type) && !type.TryParse(values[i], out _, out var error))
            {
                _errors[i] = error ?? "некоректне значення";
                valid = false;
            }
        }
        if (!valid)
            return;

        _busy = true;
        try
        {
            var failure = await Submit(values);
            if (failure is not null)
                ShowServerErrors(failure);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ShowServerErrors(ApiException failure)
    {
        var errors = failure.Errors.Count > 0 ? failure.Errors : [failure.Message];
        foreach (var error in errors)
        {
            var index = -1;
            for (var i = 0; i < Schema.Fields.Count; i++)
                if (error.StartsWith($"Поле '{Schema.Fields[i].Name}'", StringComparison.OrdinalIgnoreCase))
                    index = i;
            if (index >= 0)
                _errors[index] = error;
            else
                _otherErrors.Add(error);
        }
    }
}
