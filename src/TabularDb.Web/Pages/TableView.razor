@page "/db/{Db}/t/{Table}"
@inherits ApiComponentBase

<PageTitle>@Table — @Db</PageTitle>

<Breadcrumbs Db="@Db" Table="@Table" />
<div class="title-row">
    <h1>@Table</h1>
    @if (_page is not null)
    {
        <span class="count">@RowCount(_page.Total)</span>
    }
</div>

<Messages Busy="Busy" Error="Error" Info="@Info" />

@if (_schema is not null)
{
    <div class="toolbar">
        <button type="button" class="primary" disabled="@(Busy || (_editing && _editRow is null))" @onclick="StartAdd">Додати рядок</button>
        <button type="button" disabled="@Busy" @onclick="LoadPageAsync">Оновити</button>
        <span class="spacer"></span>
        <a class="btn quiet" href="@Links.Dedup(Db, Table)">Вилучити повторювані рядки</a>
    </div>

    @if (_editing)
    {
        <RowEditor @key="_editorKey" Schema="_schema" Row="_editRow" Submit="SaveRowAsync" OnCancel="() => _editing = false" />
    }

    @if (_page is not null)
    {
        <div class="grid-wrap tall">
            <table class="data">
                <thead>
                    <tr>
                        <th class="id">id</th>
                        @foreach (var field in _schema.Fields)
                        {
                            <th class="@Cells.Align(field.Type)">@field.Name<span class="type">@field.Type</span></th>
                        }
                        <th class="actions"><span class="visually-hidden">Дії</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _page.Rows)
                    {
                        <tr @key="row.Id">
                            <td class="id">@row.Id</td>
                            @for (var i = 0; i < row.Values.Count; i++)
                            {
                                var value = row.Values[i];
                                <td class="@Cells.Align(_schema.Fields.ElementAtOrDefault(i)?.Type)">
                                    @if (value is null)
                                    {
                                        <span class="null" title="немає значення">—</span>
                                    }
                                    else
                                    {
                                        @value
                                    }
                                </td>
                            }
                            <td class="actions">
                                <button type="button" class="small quiet" disabled="@Busy" @onclick="() => StartEdit(row)">Редагувати</button>
                                <ConfirmButton Text="Видалити" Question="@($"Видалити рядок {row.Id}?")"
                                               Class="small quiet danger" Disabled="Busy" OnConfirm="() => DeleteRowAsync(row.Id)" />
                            </td>
                        </tr>
                    }
                    @if (_page.Total == 0)
                    {
                        <tr class="empty-row">
                            <td colspan="@(_schema.Fields.Count + 2)">
                                <p style="margin: 0 auto 12px">У таблиці ще немає рядків.</p>
                                <button type="button" class="primary" disabled="@(Busy || _editing)" @onclick="StartAdd">Додати перший рядок</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_page.Total > 0)
        {
            <div class="pager">
                <span>@(_skip + 1)–@(_skip + _page.Rows.Count) з @_page.Total</span>
                @if (_page.Total > PageSize)
                {
                    <button type="button" class="small" aria-label="Попередня сторінка" disabled="@(Busy || _skip == 0)" @onclick="() => ChangePageAsync(-PageSize)">◀</button>
                    <button type="button" class="small" aria-label="Наступна сторінка" disabled="@(Busy || _skip + PageSize >= _page.Total)" @onclick="() => ChangePageAsync(PageSize)">▶</button>
                }
            </div>
        }
    }
}

@code {
    private const int PageSize = ApiRoutes.DefaultPageSize;

    private TableSchemaDto? _schema;
    private RowPageDto? _page;
    private int _skip;
    private bool _editing;
    private RowDto? _editRow;
    private int _editorKey;

    [Parameter] public string Db { get; set; } = "";
    [Parameter] public string Table { get; set; } = "";

    private static string RowCount(int n)
    {
        var word = (n % 10, n % 100) switch
        {
            (1, not 11) => "рядок",
            (2 or 3 or 4, not (12 or 13 or 14)) => "рядки",
            _ => "рядків",
        };
        return $"{n} {word}";
    }

    protected override async Task OnParametersSetAsync()
    {
        _schema = null;
        _page = null;
        _skip = 0;
        _editing = false;
        if (await RunAsync(async () => _schema = await Api.GetSchemaAsync(Db, Table)))
            await LoadPageAsync();
    }

    private Task<bool> LoadPageAsync() => RunAsync(async () =>
    {
        var page = await Api.GetRowsAsync(Db, Table, _skip, PageSize);
        if (page.Rows.Count == 0 && _skip > 0 && page.Total > 0)
        {
            _skip = (page.Total - 1) / PageSize * PageSize;
            page = await Api.GetRowsAsync(Db, Table, _skip, PageSize);
        }
        _page = page;
    });

    private async Task ChangePageAsync(int delta)
    {
        _skip = Math.Max(0, _skip + delta);
        await LoadPageAsync();
    }

    private void StartAdd()
    {
        _editRow = null;
        _editorKey++;
        _editing = true;
    }

    private void StartEdit(RowDto row)
    {
        _editRow = row;
        _editorKey++;
        _editing = true;
    }

    private async Task<ApiException?> SaveRowAsync(IReadOnlyList<string?> values)
    {
        var row = _editRow;
        try
        {
            if (row is null)
            {
                var added = await Api.AddRowAsync(Db, Table, values);
                _skip = (_page?.Total ?? 0) / PageSize * PageSize;
                Info = $"Додано рядок {added.Id}.";
            }
            else
            {
                await Api.UpdateRowAsync(Db, Table, row.Id, values);
                Info = $"Рядок {row.Id} змінено.";
            }
        }
        catch (ApiException ex)
        {
            return ex;
        }

        _editing = false;
        var info = Info;
        if (await LoadPageAsync())
        {
            Info = info;
            StateHasChanged();
        }
        return null;
    }

    private async Task DeleteRowAsync(long id)
    {
        _editing = false;
        if (await RunAsync(() => Api.DeleteRowAsync(Db, Table, id)) && await LoadPageAsync())
            Info = $"Рядок {id} видалено.";
    }
}
