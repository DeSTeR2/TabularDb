@page "/db/{Db}/dedup"
@inherits ApiComponentBase

<PageTitle>Вилучення повторів — @Db</PageTitle>

<Breadcrumbs Db="@Db" Current="Вилучення повторів" />
<h1>Вилучення повторюваних рядків</h1>
<p class="explain">Порівнюються значення після розбору, тому 9:05 і 09:05:00 вважаються однаковими. Лишається перше входження кожного рядка.</p>

<Messages Busy="Busy" Error="Error" Info="@Info" />

@if (_tables is not null)
{
    @if (_tables.Count == 0)
    {
        <div class="empty">
            <p>У базі немає таблиць.</p>
            <a class="btn primary" href="@Links.NewTable(Db)">Створити таблицю</a>
        </div>
    }
    else
    {
        <div class="inline-form" style="margin: 24px 0">
            <label class="field" style="flex: 0 1 280px">
                <span>Таблиця</span>
                <select value="@_table" @onchange="SelectTable">
                    @foreach (var table in _tables)
                    {
                        <option value="@table">@table</option>
                    }
                </select>
            </label>
            <button type="button" class="@(_preview is null ? "primary" : null)" disabled="@Busy" @onclick="PreviewAsync">Знайти повтори</button>
            @if (_preview is { RemovedCount: > 0 })
            {
                <button type="button" class="danger-solid" disabled="@Busy" @onclick="RemoveAsync">Вилучити @_preview.RemovedCount</button>
            }
        </div>
    }
}

@if (_preview is not null && _schema is not null)
{
    @if (_preview.RemovedCount == 0)
    {
        <div class="note note-info" role="status"><p>У таблиці «@_table» повторюваних рядків немає.</p></div>
    }
    else
    {
        <p>
            <span class="big-number">@_preview.RemovedCount</span>
            <span>повторюваних рядків буде вилучено</span>
            @if (_preview.RemovedRows.Count < _preview.RemovedCount)
            {
                <span class="muted">(нижче показано перші @_preview.RemovedRows.Count)</span>
            }
        </p>
        <div class="grid-wrap tall">
            <table class="data">
                <thead>
                    <tr>
                        <th class="id">id</th>
                        @foreach (var field in _schema.Fields)
                        {
                            <th class="@Cells.Align(field.Type)">@field.Name<span class="type">@field.Type</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _preview.RemovedRows)
                    {
                        <tr>
                            <td class="id">@row.Id</td>
                            @for (var i = 0; i < row.Values.Count; i++)
                            {
                                var value = row.Values[i];
                                <td class="@Cells.Align(_schema.Fields.ElementAtOrDefault(i)?.Type)">
                                    @if (value is null)
                                    {
                                        <span class="null" title="немає значення">—</span>
                                    }
                                    else
                                    {
                                        @value
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (_removedFrom is not null)
{
    <div class="toolbar">
        <a class="btn" href="@Links.Table(Db, _removedFrom)">Відкрити таблицю «@_removedFrom»</a>
        <a class="btn" href="@Links.Database(Db)">Перейти до бази, щоб зберегти</a>
    </div>
}

@code {
    private IReadOnlyList<string>? _tables;
    private string? _table;
    private TableSchemaDto? _schema;
    private DedupResultDto? _preview;
    private string? _removedFrom;

    [Parameter] public string Db { get; set; } = "";

    [SupplyParameterFromQuery(Name = "table")]
    public string? InitialTable { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _preview = null;
        _removedFrom = null;
        await RunAsync(async () =>
        {
            _tables = (await Api.ListTablesAsync(Db)).Tables;
            _table = _tables.FirstOrDefault(t => string.Equals(t, InitialTable, StringComparison.OrdinalIgnoreCase))
                ?? _tables.FirstOrDefault();
        });
    }

    private void SelectTable(ChangeEventArgs e)
    {
        _table = e.Value as string;
        _preview = null;
        _removedFrom = null;
        Info = null;
    }

    private async Task PreviewAsync()
    {
        var table = _table;
        if (table is null)
            return;
        _removedFrom = null;
        await RunAsync(async () =>
        {
            _schema = await Api.GetSchemaAsync(Db, table);
            _preview = await Api.RemoveDuplicatesAsync(Db, table, dryRun: true);
        });
    }

    private async Task RemoveAsync()
    {
        var table = _table;
        if (table is null)
            return;
        DedupResultDto? result = null;
        if (await RunAsync(async () => result = await Api.RemoveDuplicatesAsync(Db, table, dryRun: false)))
        {
            _preview = null;
            _removedFrom = table;
            Info = $"Вилучено рядків: {result!.RemovedCount}. Не забудьте зберегти базу.";
        }
    }
}
