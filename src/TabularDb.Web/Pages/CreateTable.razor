@page "/db/{Db}/new-table"
@using TabularDb.Core.Validation
@inherits ApiComponentBase

<PageTitle>Нова таблиця — @Db</PageTitle>

<Breadcrumbs Db="@Db" Current="Нова таблиця" />
<h1>Нова таблиця</h1>

<form @onsubmit="CreateAsync" style="margin-top: 24px">
    <label class="field" style="max-width: 360px">
        <span>Назва таблиці</span>
        <input @bind="_name" maxlength="64" placeholder="напр. lessons" />
    </label>

    <h2>Поля</h2>
    <div class="grid-wrap" style="max-width: 760px">
        <table class="data schema-rows">
            <thead>
                <tr><th class="id">№</th><th>Назва поля</th><th>Тип</th><th class="actions"><span class="visually-hidden">Дії</span></th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < _fields.Count; i++)
                {
                    var field = _fields[i];
                    var number = i + 1;
                    <tr @key="field">
                        <td class="id">@number</td>
                        <td><input @bind="field.Name" maxlength="64" aria-label="@($"Назва поля {number}")" /></td>
                        <td>
                            <select @bind="field.Type" aria-label="@($"Тип поля {number}")">
                                <option value="">оберіть тип</option>
                                @foreach (var type in _types)
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                        </td>
                        <td class="actions">
                            <button type="button" class="small quiet danger" disabled="@(_fields.Count == 1)"
                                    @onclick="() => _fields.Remove(field)">Прибрати</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p style="margin-top: 12px"><button type="button" @onclick="() => _fields.Add(new FieldModel())">Додати поле</button></p>

    @if (_localErrors.Count > 0)
    {
        <div class="note note-error" role="alert">
            <p><strong>Перевірте схему:</strong></p>
            <ul>
                @foreach (var error in _localErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }
    <Messages Busy="Busy" Error="Error" />

    <div class="toolbar" style="margin-top: 32px">
        <button type="submit" class="primary" disabled="@Busy">Створити таблицю</button>
        <a class="btn quiet" href="@Links.Database(Db)">Скасувати</a>
    </div>
</form>

@code {
    private sealed class FieldModel
    {
        public string Name { get; set; } = "";
        public string Type { get; set; } = "";
    }

    private readonly List<FieldModel> _fields = [new()];
    private IReadOnlyList<string> _types = TabularDb.Core.Types.TypeRegistry.Names;
    private IReadOnlyList<string> _localErrors = [];
    private string _name = "";

    [Parameter] public string Db { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        await RunAsync(async () => _types = (await Api.ListDatabasesAsync()).Types);
    }

    private async Task CreateAsync()
    {
        var name = _name.Trim();
        var fields = _fields.Select(f => new FieldDto(f.Name.Trim(), f.Type)).ToList();
        _localErrors = SchemaValidator
            .Validate(null, name, fields.Select(f => new FieldDefinition(f.Name, f.Type)).ToList())
            .Errors;
        Error = null;
        if (_localErrors.Count > 0)
            return;

        TableSchemaDto? created = null;
        if (await RunAsync(async () => created = await Api.CreateTableAsync(Db, new CreateTableRequest(name, fields))))
            Navigation.NavigateTo(Links.Table(Db, created!.Name));
    }
}
